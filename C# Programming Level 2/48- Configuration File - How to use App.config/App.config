<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<!--
	appSettings:
	General-purpose key/value storage.

	Used for simple application configuration values
	(strings, flags, feature switches, custom settings).

	Keys and values are arbitrary and defined by the developer.
	The .NET configuration system does not assign special meaning
	to individual keys.

	Read using:
	ConfigurationManager.AppSettings["KeyName"]
	-->
	<appSettings>
		<add key="ConnectionString" value="Data Source=ServerName;Initial Catalog=DatabaseName;Integrated Security=True" />
		<add key="LogLevel" value="Debug" />
		<add key="koko" value="Koko Value" />
	</appSettings>



	<!--
	connectionStrings:
	Predefined .NET configuration section (NOT built into XML).

	Designed specifically for storing database connection strings.

	Unlike appSettings, .NET recognizes this section automatically
	and exposes it through ConfigurationManager.ConnectionStrings.

	Supports additional structured metadata such as providerName
	(database provider / driver information).

	Read using:
	ConfigurationManager.ConnectionStrings["MyDbConnection"]
	-->
	<connectionStrings>
		<add
			name="MyDbConnection"
			connectionString="Data Source=ServerName;Initial Catalog=DatabaseName;Integrated Security=True"
			providerName="System.Data.SqlClient" />
	</connectionStrings>



</configuration>